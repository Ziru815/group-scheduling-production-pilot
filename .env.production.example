# Copy values into Railway's app service. Never commit real values.
APP_ENVIRONMENT=production
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>
ALLOWED_ORIGINS=https://<generated-domain>
AUTO_CREATE_TABLES=false
APP_SESSION_SECRET=<random-secret-at-least-32-characters>
DEBUG_AUTH_ENABLED=false
USE_MOCK_PROVIDERS=false
FRONTEND_BASE_URL=https://<generated-domain>
STATIC_DIR=/app/static
SESSION_COOKIE_NAME=group_scheduler_session
SESSION_COOKIE_SECURE=true

GOOGLE_CLIENT_ID=<google-oauth-client-id>
GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>
GOOGLE_REDIRECT_URI=https://<generated-domain>/api/auth/google/callback

# Use a OneMap token for the public pilot. Do not include email/password when a
# token is configured.
ONEMAP_TOKEN=<onemap-token>
ONEMAP_EMAIL=
ONEMAP_PASSWORD=

LTA_ACCOUNT_KEY=
DEFAULT_JOURNEY_CAP_MINUTES=60
DEFAULT_MINIMUM_ATTENDEES=2
DEFAULT_SHORTLIST_SIZE=10
DEFAULT_PARTICIPANT_LIMIT=12
DEFAULT_TIMESLOT_STEP_MINUTES=15
