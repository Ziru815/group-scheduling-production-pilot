# Local defaults. Public deployment uses APP_ENVIRONMENT=production and must
# provide secrets through the platform; never put real credentials in this file.
APP_ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://group_scheduler:change_me@localhost:5432/group_scheduler
ALLOWED_ORIGINS=http://localhost:5173
AUTO_CREATE_TABLES=true
APP_SESSION_SECRET=replace-with-a-long-random-secret
DEBUG_AUTH_ENABLED=false
USE_MOCK_PROVIDERS=false
FRONTEND_BASE_URL=http://localhost:5173
SESSION_COOKIE_NAME=group_scheduler_session
SESSION_COOKIE_SECURE=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
ONEMAP_EMAIL=
ONEMAP_PASSWORD=
ONEMAP_TOKEN=
LTA_ACCOUNT_KEY=
DEFAULT_JOURNEY_CAP_MINUTES=60
DEFAULT_MINIMUM_ATTENDEES=2
DEFAULT_SHORTLIST_SIZE=10
DEFAULT_PARTICIPANT_LIMIT=12
DEFAULT_TIMESLOT_STEP_MINUTES=15

