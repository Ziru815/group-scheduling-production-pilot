digraph validate_intervals {
  graph [rankdir=TB, bgcolor="transparent", pad=0.30, nodesep=0.55, ranksep=0.55,
         outputorder=edgesfirst,
         label="AvailabilityService._validate_intervals — N=10, E=14, V(G)=6", labelloc=t,
         fontname="Helvetica", fontsize=12];
  node [shape=box, style="rounded,filled", fillcolor="#F7F4EC", color="#2F6650",
        fontname="Helvetica", fontsize=10];
  edge [color="#5B655E", fontname="Helvetica", fontsize=9];

  N1 [label="N1  Entry", shape=oval, fillcolor="#DCEBDF"];
  N2 [label="N2  ordered = sorted(intervals)"];
  N3 [label="N3  next interval?", shape=diamond, fillcolor="#FFF1CC"];
  N4 [label="N4  start before Session?", shape=diamond, fillcolor="#FFF1CC"];
  N5 [label="N5  end after Session?", shape=diamond, fillcolor="#FFF1CC"];
  N6 [label="N6  raise 422\noutside date range", fillcolor="#F7D8D5"];
  N7 [label="N7  next adjacent pair?", shape=diamond, fillcolor="#FFF1CC"];
  N8 [label="N8  current.start < previous.end?", shape=diamond, fillcolor="#FFF1CC"];
  N9 [label="N9  raise 422\noverlap", fillcolor="#F7D8D5"];
  N10 [label="N10  Common exit\nreturn ordered or propagate 422", shape=oval, fillcolor="#DCEBDF"];

  { rank=same; N4; N6; }
  { rank=same; N7; N8; N9; }

  N1 -> N2 [label="E1"];
  N2 -> N3 [label="E2"];
  N3 -> N4 [label="E3 T"];
  N3 -> N7 [label="E4 F"];
  N4 -> N6 [label="E5 T"];
  N4 -> N5 [label="E6 F"];
  N5 -> N6 [label="E7 T"];
  N5 -> N3 [label="E8 F"];
  N6 -> N10 [label="E9"];
  N7 -> N8 [label="E10 T"];
  N7 -> N10 [label="E11 F"];
  N8 -> N9 [label="E12 T"];
  N8 -> N7 [label="E13 F"];
  N9 -> N10 [label="E14"];
}
