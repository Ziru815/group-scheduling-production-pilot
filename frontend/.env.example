# Copy to .env.local to override. .env.local is gitignored.

# "false" turns off the MSW mock backend in dev and proxies /api to the real backend.
VITE_USE_MOCKS=false

# Where `npm run dev` proxies /api when mocks are off.
VITE_API_PROXY_TARGET=http://localhost:8000

# Local integrated demo only: use the backend's labelled demo identities.
# Keep false in production, where Google OAuth is used.
VITE_DEMO_AUTH=true

# Backend origin for production builds. Leave empty to call the same origin.
VITE_API_BASE_URL=
